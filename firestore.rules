rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: a user can only read and write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Habits: a signed-in user may only touch documents they own.
    match /habits/{habitId} {
      // Reading / deleting an existing doc: it must already belong to you.
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;

      // Creating: the new doc must be stamped with your own uid.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      // Updating: you own the current doc and can't reassign it to someone else.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }
  }
}
